# Public website -> backend API (Express + MariaDB)
# Browser-side calls (forms, coupons, slots) and media URL resolution
NEXT_PUBLIC_API_URL=http://localhost:4000/api/public
# Server-side calls (SSR / ISR). Can be an internal address in production
API_URL=http://localhost:4000/api/public
# Canonical site URL used for sitemap / robots / canonical tags when the API is unreachable
NEXT_PUBLIC_SITE_URL=https://www.skinfinityderma.com
