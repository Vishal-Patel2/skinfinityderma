NODE_ENV=production
PORT=4000

# Render / Cloud Database Credentials (MySQL / TiDB / Aiven / Hostinger)
# Note: Render automatically provides DATABASE_URL if using Render PostgreSQL/MySQL, or set individual fields:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Auth
JWT_SECRET=b7f22ccdf1b8299b666e5aa18f2e1482329e83a0a97d9da114b1290edc76df85ed935c346b8c0ebb2c06d045f5dc72a6
JWT_EXPIRES_IN=12h

# CORS (Allow your exact Vercel frontend and custom domains)
CORS_ORIGINS=https://skinfinityderma.vercel.app,https://www.skinfinityderma.com,https://skinfinityderma.onrender.com

# Public URL of API / Uploads on Render
PUBLIC_BASE_URL=https://skinfinityderma.onrender.com

# Persistent Storage Options for Render:
# 1. Render Persistent Disk (Recommended if keeping files on Render):
#    Attach a Render Persistent Disk to the web service and set its mount path here:
#    UPLOADS_DIR=/var/data/uploads
# 2. Default relative directory:
UPLOADS_DIR=uploads

# 3. Optional Cloudinary Persistent Object Storage:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
