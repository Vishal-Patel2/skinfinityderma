{
  "name": "skinfinity-derma-backend",
  "version": "2.0.0",
  "description": "Skinfinity Derma — REST API, RBAC, CMS & clinic operations backend (Express + MySQL/MariaDB)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "db:seed:core": "node database/seed.js --no-demo",
    "db:reset": "node database/migrate.js --fresh && node database/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.11.3",
    "sharp": "^0.33.5"
  }
}
