NODE_ENV=development
PORT=4000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skinfinity_derma

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# Comma separated list of website origins allowed to call the public API
CORS_ORIGINS=http://localhost:3000,https://www.skinfinityderma.com

# Public URL of this API (used to build absolute /uploads URLs for the website)
PUBLIC_BASE_URL=http://localhost:4000
UPLOADS_DIR=uploads
