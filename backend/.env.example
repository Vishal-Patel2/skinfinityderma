NODE_ENV=development
PORT=4000

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skinfinity_derma

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# Comma separated list of website origins allowed to call the public API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.skinfinityderma.com,https://skinfinityderma.vercel.app,https://skinfinityderma.onrender.com

# Public URL of this API (used to build absolute /uploads URLs for the website)
PUBLIC_BASE_URL=http://localhost:4000

# Persistent Storage Strategy:
# 1. Local / Render Persistent Disk: Set directory path (default is ./uploads)
UPLOADS_DIR=uploads

# 2. Cloud Storage (Optional - Cloudinary):
# If provided, imageStorageService can automatically sync to Cloud CDN
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
